rules_version = '2';

/* =====================================================================
   FIRESTORE RULES — Firebase console → Build → Firestore Database →
   Rules tab → paste everything below → Publish.

   One wedding = one document in collection "weddings".
   The document id IS the private guest code (e.g. k3f9xz2m7qwp4t8b).
   Nobody can list or guess codes — you must have the exact link.
   ===================================================================== */
service cloud.firestore {
  match /databases/{database}/documents {
    match /weddings/{code} {

      /* Guests with the exact private link can read that one document. */
      allow get: if true;

      /* Admins can only ever list their OWN weddings
         (the admin app always filters by ownerUid). */
      allow list: if request.auth != null
                  && resource.data.ownerUid == request.auth.uid;

      /* Only the signed-in owner can create / edit / delete. */
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;

      /* NOTE: update and delete are SEPARATE on purpose — on a delete there is
         no "incoming document", so a rule that checks request.resource.data
         would block every delete with permission-denied. */
      allow update: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if request.auth != null
                    && resource.data.ownerUid == request.auth.uid;

      /* Files stored INSIDE Firestore (no Storage bucket, no card needed):
         photos = one small doc per picture; mp3 = chunked docs under music.
         Guests may read them, only the wedding owner can write/delete. */
      match /assets/{slot} {
        allow get: if true;
        allow write: if request.auth != null
                     && firestore.get(/databases/(default)/documents/weddings/$(code))
                          .data.ownerUid == request.auth.uid;

        /* mp3 track chunks (assets/music/chunks/<n>) */
        match /chunks/{n} {
          allow get: if true;
          allow write: if request.auth != null
                       && firestore.get(/databases/(default)/documents/weddings/$(code))
                            .data.ownerUid == request.auth.uid;
        }
      }
    }
  }
}
